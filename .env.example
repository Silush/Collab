# ─── Credenciais do Meta / Instagram ───────────────────────────────────────────

# Token de acesso da Página do Facebook (precisa das permissões:
#   instagram_manage_comments, instagram_manage_messages, pages_messaging)
PAGE_ACCESS_TOKEN=seu_page_access_token_aqui

# ID numérico do seu usuário no Instagram (IG User ID)
# Para encontrar: GET https://graph.facebook.com/me/accounts -> id do IG vinculado
IG_USER_ID=seu_ig_user_id_aqui

# Token secreto que você mesmo define para verificar o webhook no Meta
WEBHOOK_VERIFY_TOKEN=um_token_secreto_qualquer

# ─── Configurações do servidor ──────────────────────────────────────────────────
# Porta onde o servidor rodará localmente
PORT=5000
